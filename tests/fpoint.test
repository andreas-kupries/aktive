# -*- tcl -*- tcl.tk//DSL tcltest//EN//2.0 tcl.tk//DSL tcltest//EN//2.0
## (c) 2023,2024 Andreas Kupries
# # ## ### ##### ######## ############# #####################
## AKTIVE. Point operations, fractional points

kt check Tcl     8.6 9
kt check tcltest 2

# # ## ### ##### ######## ############# #####################

kt local testing aktive

kt source support/util.tcl

# # ## ### ##### ######## ############# #####################
## Syntax

syntax {
    make     {x y}
    move     {point dx dy}
    add      {point delta}
    box       args
} {aktive fpoint}

# # ## ### ##### ######## ############# #####################
##

test aktive-point-make-2.0 "aktive fpoint make" -body {
    check aktive fpoint make 1.1 2.3
} -result {1.1 2.3}

# = == === ===== ======== ============= =====================

test aktive-point-move-2.0 "aktive fpoint move" -body {
    check aktive fpoint move {1.1 2.3} 2.2 3.1
} -match doubles -result {3.3 5.4}

# = == === ===== ======== ============= =====================

test aktive-point-add-2.0 "aktive fpoint add" -body {
    check aktive fpoint add {1.1 2.3} {2.2 3.1}
} -match doubles -result {3.3 5.4}

# = == === ===== ======== ============= =====================

test aktive-point-box-2.0 "aktive fpoint box, none" -body {
    check aktive fpoint box
} -match doubles -result {0 0 -1 -1}

test aktive-point-box-2.1 "aktive fpoint box, single" -body {
    check aktive fpoint box {1.1 2.1}
} -match doubles -result {1.1 2.1 1.1 2.1}

test aktive-point-box-2.2 "aktive fpoint box, many" -body {
    check aktive fpoint box {0.1 0.2} {4 3} {5 5.5} {6.3 2}
} -match doubles -result {0.1 0.2 6.3 5.5}

# # ## ### ##### ######## ############# #####################
cleanupTests
return
