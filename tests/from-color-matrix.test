# # ## ### ##### ######## ############# #####################
## AKTIVE. Image from matrix of color names

kt check Tcl     8.6 9
kt check tcltest 2

# # ## ### ##### ######## ############# #####################

kt local testing aktive

kt source support/util.tcl

# # ## ### ##### ######## ############# #####################
## Syntax

syntax {
    color-matrix args
} {aktive image from}

# # ## ### ##### ######## ############# #####################
##

test aktive-image-from-color-matrix-2.0 "aktive image from color-matrix" -body {
    pixels aktive image from color-matrix width 2 height 1 values lime khaki
} -match pixels -result {
    0 1 0
    0.9412 0.9020 0.5490
}

# # ## ### ##### ######## ############# #####################
cleanupTests
return
