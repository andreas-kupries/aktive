# -*- tcl -*- tcl.tk//DSL tcltest//EN//2.0 tcl.tk//DSL tcltest//EN//2.0
## (c) 2026 Andreas Kupries
# # ## ### ##### ######## ############# #####################
## AKTIVE. Polynomial evaluation

kt check Tcl     8.6 9
kt check tcltest 2

# # ## ### ##### ######## ############# #####################

kt local testing aktive

kt source support/util.tcl

# # ## ### ##### ######## ############# #####################

syntax {
    at {coefficients x}
} {aktive math polynomial}

# # ## ### ##### ######## ############# #####################

test aktive-math-polynomial-at-2.0 "aktive math polynomial at" -body {
    aktive math polynomial at {1 3} 5
} -match double4 -result 16

test aktive-math-polynomial-at-2.1 "aktive math polynomial at" -body {
    aktive math polynomial at {1 3 -2} 5
} -match double4 -result -34

# # ## ### ##### ######## ############# #####################

test aktive-math-polynomial-map-2.0 "aktive math polynomial map" -body {
    aktive math polynomial map {1 3} {5 6 7}
} -match double4 -result {16 19 22}

test aktive-math-polynomial-map-2.1 "aktive math polynomial map" -body {
    aktive math polynomial map {1 3 -2} {2 3 4}
} -match double4 -result {-1 -8 -19}

# # ## ### ##### ######## ############# #####################

test aktive-math-polynomial-map*-2.0 "aktive math polynomial map*" -body {
    aktive math polynomial map* {1 3} 5 6 7
} -match double4 -result {16 19 22}

test aktive-math-polynomial-map*-2.1 "aktive math polynomial map*" -body {
    aktive math polynomial map* {1 3 -2} 2 3 4
} -match double4 -result {-1 -8 -19}

# # ## ### ##### ######## ############# #####################
cleanupTests
return
