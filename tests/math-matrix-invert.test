# # ## ### ##### ######## ############# #####################
# convert to images

dict for {k v} $A {
    lassign [split $k .] _ width
    #puts stderr A//$k\t(($_))\t(($width))\t((($v)))

    dict set A $k [aktive image from matrix width $width height $width values {*}$v]
}

dict for {k v} $Z {
    lassign [split $k .] _ width
    #puts stderr Z//$k\t(($_))\t(($width))\t((($v)))

    dict set Z $k [aktive image from matrix width $width height $width values {*}$v]
}

# # ## ### ##### ######## ############# #####################
## matrix combinations (depth variations)

proc m {var args} {
    upvar 1 $var dst
    set key [join $args /]
    set args [lmap i $args { dict get $dst $i }]
    dict set dst $key [aktive op montage z {*}$args]
}

foreach {a b} {
    1.2 2.2   2.2 3.2  3.2 4.2  4.2 5.2  5.2 6.2
    1.3 2.3   2.3 3.3  3.3 4.3  4.3 5.3  5.3 6.3
    1.4 2.4   2.4 3.4  3.4 4.4  4.4 5.4  5.4 6.4
    1.5 2.5   2.5 3.5  3.5 4.5  4.5 5.5  5.5 6.5
} { m A $a $b ; m Z $a $b }

foreach {a b c} {
    1.2 2.2 3.2   2.2 3.2 4.2  3.2 4.2 5.2  4.2 5.2 6.2
    1.3 2.3 3.3   2.3 3.3 4.3  3.3 4.3 5.3  4.3 5.3 6.3
    1.4 2.4 3.4   2.4 3.4 4.4  3.4 4.4 5.4  4.4 5.4 6.4
    1.5 2.5 3.5   2.5 3.5 4.5  3.5 4.5 5.5  4.5 5.5 6.5
} { m A $a $b $c ; m Z $a $b $c }

foreach {a b c d} {
    1.2 2.2 3.2 4.2   2.2 3.2 4.2 5.2  3.2 4.2 5.2 6.2
    1.3 2.3 3.3 4.3   2.3 3.3 4.3 5.3  3.3 4.3 5.3 6.3
    1.4 2.4 3.4 4.4   2.4 3.4 4.4 5.4  3.4 4.4 5.4 6.4
    1.5 2.5 3.5 4.5   2.5 3.5 4.5 5.5  3.5 4.5 5.5 6.5
} { m A $a $b $c $d ; m Z $a $b $c $d }

foreach {a b c d e} {
    1.2 2.2 3.2 4.2 5.2  2.2 3.2 4.2 5.2 6.2
    1.3 2.3 3.3 4.3 5.3  2.3 3.3 4.3 5.3 6.3
    1.4 2.4 3.4 4.4 5.4  2.4 3.4 4.4 5.4 6.4
    1.5 2.5 3.5 4.5 5.5  2.5 3.5 4.5 5.5 6.5
} { m A $a $b $c $d $e ; m Z $a $b $c $d $e }

foreach {a b c d e f} {
    1.2 2.2 3.2 4.2 5.2 6.2
    1.3 2.3 3.3 4.3 5.3 6.3
    1.4 2.4 3.4 4.4 5.4 6.4
    1.5 2.5 3.5 4.5 5.5 6.5
} { m A $a $b $c $d $e $f ; m Z $a $b $c $d $e $f }

rename m {}

# # ## ### ##### ######## ############# #####################
##

foreach k [lsort -dict [dict keys $A]] {
    set ex [pixels/ [dict get $Z $k]]
    set in          [dict get $A $k]

    test aktive-op-math-matrix-invert-3.$k "aktive op math matrix invert, id $k" -body {
	pixels aktive op math matrix invert $in
    } -match pixels -result $ex

    # TODO : multiply A*Z, Z*A -> verify as identity
}

##
# # ## ### ##### ######## ############# #####################
cleanupTests
return
