# -*- tcl -*- tcl.tk//DSL tcltest//EN//2.0 tcl.tk//DSL tcltest//EN//2.0
## (c) 2026 Andreas Kupries
# # ## ### ##### ######## ############# #####################
## AKTIVE. Matrix inversion

kt check Tcl     8.6 9
kt check tcltest 2

# # ## ### ##### ######## ############# #####################

kt local testing aktive

kt source support/util.tcl

# # ## ### ##### ######## ############# #####################
## Syntax

syntax {
    invert mat
} {aktive op math matrix}

# # ## ### ##### ######## ############# #####################
## Bad inputs

test aktive-op-math-matrix-invert-2.0 "aktive op math matrix invert, not square" -body {
    pixels aktive op math matrix invert \
	[aktive image from matrix width 3 height 2 values {*}{
	    1 2 3
	    4 5 6
	}]
} -returnCodes error -result {expected a square matrix}

test aktive-op-math-matrix-invert-2.1 "aktive op math matrix invert, not square" -body {
    pixels aktive op math matrix invert \
	[aktive image from matrix width 2 height 3 values {*}{
	    1 2
	    3 4
	    5 6
	}]
} -returnCodes error -result {expected a square matrix}

test aktive-op-math-matrix-invert-2.2 "aktive op math matrix invert, 1x1 singular" -body {
    pixels aktive op math matrix invert \
	[aktive image from matrix width 1 height 1 values 0]
} -returnCodes error -result {unable to invert (near-)singular matrix}

test aktive-op-math-matrix-invert-2.2 "aktive op math matrix invert, 2x2 singular" -body {
    pixels aktive op math matrix invert \
	[aktive image from matrix width 2 height 2 values {*}{
	    0 5
	    0 1
	}]
} -returnCodes error -result {unable to invert (near-)singular matrix}

test aktive-op-math-matrix-invert-2.3 "aktive op math matrix invert, 2x2 singular" -body {
    pixels aktive op math matrix invert \
	[aktive image from matrix width 2 height 2 values {*}{
	    2 1
	    4 2
	}]
} -returnCodes error -result {unable to invert (near-)singular matrix}

test aktive-op-math-matrix-invert-2.4 "aktive op math matrix invert, 3x3 singular" -body {
    pixels aktive op math matrix invert \
	[aktive image from matrix width 3 height 3 values {*}{
	    1 2 3
	    2 4 6
	    3 3 3
	}]
} -returnCodes error -result {unable to invert (near-)singular matrix}

test aktive-op-math-matrix-invert-2.5 "aktive op math matrix invert, 4x4 singular" -body {
    pixels aktive op math matrix invert \
	[aktive image from matrix width 4 height 4 values {*}{
	    1 2 3 4
	    2 4 6 8
	    3 2 3 2
	    9 8 7 6
	}]
} -returnCodes error -result {unable to invert (near-)singular matrix}

# # ## ### ##### ######## ############# #####################
## inputs of varying sizes, and inversion results

set A {
