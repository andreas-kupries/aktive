# -*- tcl -*- tcl.tk//DSL tcltest//EN//2.0 tcl.tk//DSL tcltest//EN//2.0
## (c) 2023,2024 Andreas Kupries
# # ## ### ##### ######## ############# #####################
## AKTIVE. Color correction - Grey world, global and local

kt check Tcl     8.6 9
kt check tcltest 2

# # ## ### ##### ######## ############# #####################

kt local testing aktive

kt source support/util.tcl

# # ## ### ##### ######## ############# #####################
## Syntax

syntax {
    global     {src args}
    global-mean src
} {aktive op color correct greyworld}

syntax {
    local  {src args}
} aktive::op::color::correct::greyworld

# # ## ### ##### ######## ############# #####################
##

foreach mp {
    global
    {local radius 5}
} {
    set m [lindex $mp 0]
    set p [lrange $mp 1 end]
    set k 0
    foreach im {
	butterfly
	watergarden
    } {
	set in [aktive read from netpbm file path [A $im.ppm]]

	test aktive-op-color-correct-greyworld-${m}-2.$k \
	    "aktive op color correct greyworld $m $im $p" -body {
	    save-to test.gw-${m}.ppm \
		[aktive op color correct greyworld $m $in {*}$p] \
		aktive format as ppm byte
	} -cleanup {
	    removeFile test.gw-${m}.ppm
	} -match content -result [R greyworld-${m}-${im}.ppm]

	incr k
    }
}

# # ## ### ##### ######## ############# #####################

foreach im {
    butterfly
    watergarden
} {
    test aktive-op-color-correct-greyworld-global-mean-2.$k \
	"aktive op color correct greyworld global-mean $im" -body {
	aktive op color correct greyworld global-mean \
	    [aktive read from netpbm file path \
		 [A $im.ppm]]
    } -result [dict get {
	butterfly   0.19901710802644593
	watergarden 0.290419223329153
    } $im]

    incr k
}

# # ## ### ##### ######## ############# #####################
unset mp m p k im
cleanupTests
return
