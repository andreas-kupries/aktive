right

M: circle "maker"

arrow from M.e
T: box "tasks" "#workers" fit
arrow right 150%
WS: box invisible "..."
arrow
R: box "results" "#workers" fit
arrow
C: circle "completer"

arrow from T.ne up right then right until even with WS.w
W1: circle "worker"

arrow from T.se down right then right until even with WS.w
W2: circle "worker"

arrow <- from R.nw up   left then to W1.e
arrow <- from R.sw down left then to W2.e

arrow from C.s down 150% \
      then left until even with T.s \
      then to T.s dashed
